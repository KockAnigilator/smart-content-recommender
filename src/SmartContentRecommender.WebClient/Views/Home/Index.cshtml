@model SmartContentRecommender.WebClient.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Smart Content Recommender (Web)";
}

<div class="mx-auto" style="max-width: 980px;">
<div class="mb-3 text-center"></div>
@if (!Model.IsAuthenticated)
{
    <ul class="nav nav-tabs justify-content-center" id="authTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button" role="tab" aria-controls="login" aria-selected="true">Вход</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button" role="tab" aria-controls="register" aria-selected="false">Регистрация</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4" id="authTabsContent">
        <div class="tab-pane fade show active" id="login" role="tabpanel" aria-labelledby="login-tab">
            <h4 class="mb-3 text-center">Вход</h4>
            <form method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="Email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <input class="form-control" type="password" name="Password" required />
                </div>
                <div class="text-center">
                    <button class="btn btn-primary px-4" type="submit">Войти</button>
                </div>
            </form>

            <div class="mt-3 small text-muted text-center">
                Демо пользователи (seed в Development):
                <div>admin@local / Admin123!</div>
                <div>user1@local / User123!</div>
            </div>
        </div>

        <div class="tab-pane fade" id="register" role="tabpanel" aria-labelledby="register-tab">
            <h4 class="mb-3 text-center">Регистрация</h4>
            <form method="post" asp-controller="Account" asp-action="Register">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="Email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <input class="form-control" type="password" name="Password" required />
                </div>
                <div class="text-center">
                    <button class="btn btn-primary px-4" type="submit">Зарегистрироваться</button>
                </div>
            </form>
            <div class="mt-3 small text-muted text-center">
                Требования к паролю: минимум 8 символов, хотя бы 1 заглавная буква, 1 цифра и 1 спецсимвол.
            </div>
        </div>
    </div>
}
else
{
    <div class="mb-3 text-center">
        <div><b>Вы в системе.</b> Роль: <span class="fw-semibold">@Model.Role</span></div>
        <div class="mt-2">
            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-secondary btn-sm" type="submit">Выйти</button>
            </form>
        </div>
    </div>

    <ul class="nav nav-tabs justify-content-center" id="mainTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="content-tab" data-bs-toggle="tab" data-bs-target="#content" type="button" role="tab" aria-controls="content" aria-selected="true">Контент</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="recommend-tab" data-bs-toggle="tab" data-bs-target="#recommend" type="button" role="tab" aria-controls="recommend" aria-selected="false">Рекомендации</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Профиль интересов</button>
        </li>

        @if (Model.IsAdmin)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin" type="button" role="tab" aria-controls="admin" aria-selected="false">Админ: Пользователи</button>
            </li>
        }
    </ul>

    <div class="tab-content border border-top-0 p-3" id="mainTabsContent">
        <div class="tab-pane fade show active" id="content" role="tabpanel" aria-labelledby="content-tab">
            <h4 class="mb-3">Контент</h4>
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>URL</th>
                    <th style="width: 240px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Contents)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.CategoryName</td>
                        <td style="word-break: break-word;">@item.Url</td>
                        <td>
                            <form method="post" asp-controller="Home" asp-action="LogAction" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contentId" value="@item.Id" />
                                <input type="hidden" name="type" value="0" />
                                <button class="btn btn-sm btn-outline-primary me-1" type="submit">View</button>
                            </form>
                            <form method="post" asp-controller="Home" asp-action="LogAction" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contentId" value="@item.Id" />
                                <input type="hidden" name="type" value="1" />
                                <button class="btn btn-sm btn-outline-success me-1" type="submit">Like</button>
                            </form>
                            <form method="post" asp-controller="Home" asp-action="LogAction" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contentId" value="@item.Id" />
                                <input type="hidden" name="type" value="2" />
                                <button class="btn btn-sm btn-outline-warning" type="submit">Click</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="recommend" role="tabpanel" aria-labelledby="recommend-tab">
            <h4 class="mb-3">Рекомендации</h4>

            <ul class="nav nav-pills mb-3" id="recTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="popular-rec-tab" data-bs-toggle="tab" data-bs-target="#popular-rec" type="button" role="tab" aria-controls="popular-rec" aria-selected="true">Popular</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="cat-rec-tab" data-bs-toggle="tab" data-bs-target="#cat-rec" type="button" role="tab" aria-controls="cat-rec" aria-selected="false">By Categories</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="knn-rec-tab" data-bs-toggle="tab" data-bs-target="#knn-rec" type="button" role="tab" aria-controls="knn-rec" aria-selected="false">KNN</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="popular-rec" role="tabpanel" aria-labelledby="popular-rec-tab">
                    @await Html.PartialAsync("_RecommendationTablePartial", Model.Popular)
                </div>
                <div class="tab-pane fade" id="cat-rec" role="tabpanel" aria-labelledby="cat-rec-tab">
                    @await Html.PartialAsync("_RecommendationTablePartial", Model.ByCategories)
                </div>
                <div class="tab-pane fade" id="knn-rec" role="tabpanel" aria-labelledby="knn-rec-tab">
                    @await Html.PartialAsync("_RecommendationTablePartial", Model.Knn)
                </div>
            </div>

            <h5 class="mt-4">Explainability (KNN)</h5>
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Popular</th>
                        <th>Category</th>
                        <th>KNN</th>
                        <th>Final</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.ExplainKnn.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">Нет explainability данных</td></tr>
                }
                else
                {
                    @foreach (var e in Model.ExplainKnn)
                    {
                        <tr>
                            <td>@e.Title</td>
                            <td>@e.PopularityFactor</td>
                            <td>@e.CategoryAffinityFactor</td>
                            <td>@e.KnnSimilarityFactor</td>
                            <td>@e.FinalScore</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <h4 class="mb-3">Персональный профиль интересов</h4>

            @if (Model.ShowDemoHistoryButton)
            {
                <form method="post" asp-controller="Home" asp-action="GenerateDemoHistory" class="mb-3">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-primary" type="submit">Сгенерировать демо-историю (Dev)</button>
                </form>
            }

            @if (Model.InterestProfile is null)
            {
                <div class="alert alert-secondary">Пока не удалось построить профиль интересов.</div>
            }
            else
            {
                <div class="mb-2"><b>Всего действий:</b> @Model.InterestProfile.TotalActions</div>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Топ категорий</h5>
                        <ul class="list-group">
                            @if (Model.InterestProfile.TopCategories.Count == 0)
                            {
                                <li class="list-group-item text-muted">Нет данных</li>
                            }
                            else
                            {
                                @foreach (var item in Model.InterestProfile.TopCategories)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@item.Name</span>
                                        <span class="badge text-bg-primary rounded-pill">@item.Score</span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Топ тегов</h5>
                        <ul class="list-group">
                            @if (Model.InterestProfile.TopTags.Count == 0)
                            {
                                <li class="list-group-item text-muted">Нет данных</li>
                            }
                            else
                            {
                                @foreach (var item in Model.InterestProfile.TopTags)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@item.Name</span>
                                        <span class="badge text-bg-success rounded-pill">@item.Score</span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="admin" role="tabpanel" aria-labelledby="admin-tab">
            <h4 class="mb-3">Управление пользователями</h4>
            <div class="mb-3">
                <form method="post" asp-controller="Home" asp-action="DownloadReportCsv" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-primary me-2" type="submit">Экспорт CSV</button>
                </form>
                <form method="post" asp-controller="Home" asp-action="DownloadReportPdf" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-primary" type="submit">Экспорт PDF</button>
                </form>
            </div>
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Блок</th>
                    <th style="width: 300px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.AdminUsers)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>@u.Role</td>
                        <td>@u.IsBlocked</td>
                        <td>
                            <form method="post" asp-controller="Home" asp-action="ChangeRole" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="role" value="Admin" />
                                <button class="btn btn-sm btn-outline-dark me-1" type="submit">Admin</button>
                            </form>
                            <form method="post" asp-controller="Home" asp-action="ChangeRole" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="role" value="User" />
                                <button class="btn btn-sm btn-outline-secondary me-1" type="submit">User</button>
                            </form>

                            <form method="post" asp-controller="Home" asp-action="SetBlocked" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="isBlocked" value="true" />
                                <button class="btn btn-sm btn-outline-danger me-1" type="submit">Block</button>
                            </form>
                            <form method="post" asp-controller="Home" asp-action="SetBlocked" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="isBlocked" value="false" />
                                <button class="btn btn-sm btn-outline-success me-1" type="submit">Unblock</button>
                            </form>

                            <form method="post" asp-controller="Home" asp-action="DeleteUser" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Delete</button>
                            </form>
                            <form method="post" asp-controller="Home" asp-action="ShowMetrics" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="algorithm" value="knn" />
                                <button class="btn btn-sm btn-outline-info ms-1" type="submit">Metrics KNN</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.SelectedMetrics is not null)
            {
                <div class="alert alert-info mt-3">
                    <b>Metrics (@Model.SelectedMetrics.Algorithm)</b> |
                    UserId: @Model.SelectedMetrics.UserId |
                    P@K: @Model.SelectedMetrics.PrecisionAtK |
                    R@K: @Model.SelectedMetrics.RecallAtK |
                    NDCG@K: @Model.SelectedMetrics.NdcgAtK
                </div>
            }

            <hr class="my-4" />
            <h4 class="mb-3">Админ: Управление контентом</h4>
            <div class="row">
                <div class="col-md-6">
                    <h6>Создать контент</h6>
                    <form method="post" asp-controller="Home" asp-action="CreateContent">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <input class="form-control" name="Title" placeholder="Title" required />
                        </div>
                        <div class="mb-2">
                            <input class="form-control" name="Url" placeholder="Url" required />
                        </div>
                        <div class="mb-2">
                            <textarea class="form-control" name="Description" placeholder="Description"></textarea>
                        </div>
                        <div class="mb-2">
                            <select class="form-select" name="CategoryId" required>
                                <option value="">Категория</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <input class="form-control" name="TagIdsCsv" placeholder="TagIds CSV (guid,guid,...)" />
                            <div class="form-text">Подсказка: GUID тегов можно посмотреть во вкладке “База данных”.</div>
                        </div>
                        <button class="btn btn-sm btn-primary" type="submit">Создать</button>
                    </form>
                </div>
                <div class="col-md-6">
                    <h6>Обновить контент</h6>
                    <form method="post" asp-controller="Home" asp-action="UpdateContent">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <input class="form-control" name="Id" placeholder="ContentId (guid)" required />
                        </div>
                        <div class="mb-2">
                            <input class="form-control" name="Title" placeholder="Title" required />
                        </div>
                        <div class="mb-2">
                            <input class="form-control" name="Url" placeholder="Url" required />
                        </div>
                        <div class="mb-2">
                            <textarea class="form-control" name="Description" placeholder="Description"></textarea>
                        </div>
                        <div class="mb-2">
                            <select class="form-select" name="CategoryId" required>
                                <option value="">Категория</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <input class="form-control" name="TagIdsCsv" placeholder="TagIds CSV (guid,guid,...)" />
                        </div>
                        <button class="btn btn-sm btn-outline-primary" type="submit">Обновить</button>
                    </form>
                </div>
            </div>
            <div class="mt-3">
                <h6>Удалить контент</h6>
                <form method="post" asp-controller="Home" asp-action="DeleteContent" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input class="form-control" name="id" placeholder="ContentId (guid)" required />
                    <button class="btn btn-sm btn-outline-danger" type="submit">Удалить</button>
                </form>
            </div>

        </div>

    </div>
}
</div>

<div class="position-fixed bottom-0 start-0 end-0 border-top bg-light py-2 px-3" style="z-index:1050;">
    <div class="mx-auto d-flex justify-content-between align-items-center" style="max-width: 980px;">
        <div>
            @if (Model.ApiOnline)
            {
                <span class="badge text-bg-success">API работает</span>
            }
            else
            {
                <span class="badge text-bg-danger">API недоступен</span>
            }
        </div>
        <div class="small">
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <span class="text-danger">@Model.Error</span>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Info))
            {
                <span class="text-success">@Model.Info</span>
            }
            else if (Model.IsAuthenticated)
            {
                <span class="text-success">Вход выполнен</span>
            }
            else
            {
                <span class="text-muted">Ожидание входа</span>
            }
        </div>
    </div>
</div>

