<Window x:Class="SmartContentRecommender.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Smart Content Recommender (WPF Client)" Height="720" Width="1200" MinWidth="1000" MinHeight="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Авторизация" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,10,0" VerticalContentAlignment="Center" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Margin="0,0,10,0" VerticalContentAlignment="Center" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Margin="0,0,10,0" Padding="12,6" Content="Регистрация" Command="{Binding RegisterCommand}" />
                <Button Grid.Column="3" Margin="0,0,10,0" Padding="12,6" Content="Вход" Command="{Binding LoginCommand}" />
                <Button Grid.Column="4" Margin="0,0,10,0" Padding="12,6" Content="Выход" Command="{Binding LogoutCommand}" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0" FontWeight="SemiBold" Text="{Binding CurrentRole, StringFormat=Роль: {0}}" />
                    <TextBlock Margin="0,0,12,0" FontWeight="SemiBold" Foreground="{Binding ApiStatusBrush}" Text="{Binding ApiStatusText}" />
                    <Button Padding="10,4" Content="Проверить API" Command="{Binding CheckApiCommand}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Контент" Margin="0,0,10,0" Padding="8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Padding="10,4" Margin="0,0,8,0" Content="Обновить контент" Command="{Binding LoadContentCommand}" />
                        <Button Padding="10,4" Margin="0,0,8,0" Content="View" Command="{Binding LogViewCommand}" />
                        <Button Padding="10,4" Margin="0,0,8,0" Content="Like" Command="{Binding LogLikeCommand}" />
                        <Button Padding="10,4" Margin="0,0,8,0" Content="Click" Command="{Binding LogClickCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding ContentItems}"
                              SelectedItem="{Binding SelectedContent}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <TabControl Grid.Column="1">
                <TabItem Header="Рекомендации">
                    <DockPanel Margin="8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Popular" Command="{Binding LoadPopularCommand}" />
                            <Button Padding="10,4" Margin="0,0,8,0" Content="By Categories" Command="{Binding LoadByCategoriesCommand}" />
                            <Button Padding="10,4" Content="KNN" Command="{Binding LoadKnnCommand}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding RecommendationItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" />
                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Админ: Пользователи"
                         Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Обновить" Command="{Binding LoadAdminUsersCommand}" />
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Сделать Admin" Command="{Binding MakeAdminCommand}" />
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Сделать User" Command="{Binding MakeUserCommand}" />
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Блок" Command="{Binding BlockUserCommand}" />
                            <Button Padding="10,4" Margin="0,0,8,0" Content="Разблок" Command="{Binding UnblockUserCommand}" />
                            <Button Padding="10,4" Content="Удалить" Command="{Binding DeleteUserCommand}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding AdminUsers}"
                                  SelectedItem="{Binding SelectedAdminUser}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*" />
                                <DataGridCheckBoxColumn Header="Блок" Binding="{Binding IsBlocked}" Width="*" />
                                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAtUtc}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Status}"
                       FontWeight="SemiBold"
                       Margin="2,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding IsBusy, StringFormat=Загрузка: {0}}" />
                <ProgressBar Width="120" Height="12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
