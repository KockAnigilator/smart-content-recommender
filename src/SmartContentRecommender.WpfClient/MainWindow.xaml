<Window x:Class="SmartContentRecommender.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Smart Content Recommender (Desktop)"
        Height="760"
        Width="1240"
        MinWidth="1080"
        MinHeight="640"
        Background="#EEF2F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D5DEEA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#EAF1FB" />
            <Setter Property="BorderBrush" Value="#BFD1EA" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FBFF" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderBrush" Value="#D5DEEA" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" Padding="10" BorderBrush="#DDE3EA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Height="34"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Height="34"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Margin="0,0,14,0" FontWeight="SemiBold" Text="{Binding CurrentRole, StringFormat=Роль: {0}}" />
                    <TextBlock Margin="0,0,14,0" FontWeight="SemiBold" Foreground="{Binding ApiStatusBrush}" Text="{Binding ApiStatusText}" />
                    <Button Content="Проверить API" Command="{Binding CheckApiCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,12">
            <TabItem Header="Вход и регистрация">
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#DDE3EA" BorderThickness="1">
                    <Grid MaxWidth="620" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Авторизация" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Grid.Row="1" Text="Email" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1" Height="34" Margin="70,0,0,12" VerticalContentAlignment="Center" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="Пароль" Margin="0,0,0,6" />
                        <TextBox Grid.Row="2" Height="34" Margin="70,0,0,12" VerticalContentAlignment="Center" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Регистрация" Command="{Binding RegisterCommand}" />
                            <Button Content="Вход" Command="{Binding LoginCommand}" />
                            <Button Content="Выход" Command="{Binding LogoutCommand}" />
                        </StackPanel>

                        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10" Background="#F8FAFD" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Демо-доступы:" />
                                <TextBlock Margin="0,4,0,0" Text="Admin: admin@local / Admin123!" />
                                <TextBlock Text="User: user1@local / User123!" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Приложение" Visibility="{Binding IsAuthorized, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" CornerRadius="8" Padding="10" BorderBrush="#DDE3EA" BorderThickness="1" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="Обновить контент" Command="{Binding LoadContentCommand}" />
                                <Button Content="Просмотр" Command="{Binding LogViewCommand}" />
                                <Button Content="Лайк" Command="{Binding LogLikeCommand}" />
                                <Button Content="Клик" Command="{Binding LogClickCommand}" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding ContentItems}" SelectedItem="{Binding SelectedContent}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" BorderBrush="#DDE3EA" BorderThickness="1">
                        <TabControl>
                            <TabItem Header="Рекомендации">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1.5*" />
                                        <RowDefinition Height="1.5*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                                        <Button Content="Popular" Command="{Binding LoadPopularCommand}" />
                                        <Button Content="By Categories" Command="{Binding LoadByCategoriesCommand}" />
                                        <Button Content="KNN" Command="{Binding LoadKnnCommand}" />
                                        <Button Content="Объяснить KNN" Command="{Binding LoadExplainCommand}" />
                                        <Button Content="Профиль интересов" Command="{Binding LoadInterestProfileCommand}" />
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecommendationItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Grid.Row="2" Margin="0,10,0,6" FontWeight="SemiBold" Text="Explainability (KNN factors)" />
                                    <DataGrid Grid.Row="3" ItemsSource="{Binding ExplainItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="Popular" Binding="{Binding PopularityFactor}" Width="*" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryAffinityFactor}" Width="*" />
                                            <DataGridTextColumn Header="KNN" Binding="{Binding KnnSimilarityFactor}" Width="*" />
                                            <DataGridTextColumn Header="Final" Binding="{Binding FinalScore}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="4" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <GroupBox Header="Топ категорий" Grid.Column="0" Margin="0,0,6,0">
                                            <DataGrid ItemsSource="{Binding InterestCategories}" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="2*" />
                                                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                        <GroupBox Header="Топ тегов" Grid.Column="1" Margin="6,0,0,0">
                                            <DataGrid ItemsSource="{Binding InterestTags}" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Тег" Binding="{Binding Name}" Width="2*" />
                                                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Графики и аналитика" Visibility="{Binding IsAuthorized, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel Margin="8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button Content="Обновить графики" Command="{Binding LoadDesktopDashboardCommand}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="{Binding DashboardSummary}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <GroupBox Header="Распределение топ категорий" Grid.Row="0">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6" Foreground="Gray" Text="{Binding CategoryDistributionStatus}" />
                                                <Border BorderBrush="#D5DEEA" BorderThickness="1" CornerRadius="6" Background="#FBFCFF" Padding="8">
                                                    <Canvas Height="180">
                                                        <Line X1="40" Y1="16" X2="40" Y2="156" Stroke="#7A8798" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="156" X2="560" Y2="156" Stroke="#7A8798" StrokeThickness="1.2" />
                                                        <TextBlock Canvas.Left="8" Canvas.Top="8" FontSize="11" Foreground="#5f6b7a" Text="Y: score" />
                                                        <TextBlock Canvas.Left="520" Canvas.Top="160" FontSize="11" Foreground="#5f6b7a" Text="X: rank" />
                                                        <Polyline Points="{Binding InterestCategoryPoints}" Stroke="#2A8DFF" StrokeThickness="2.6" />
                                                    </Canvas>
                                                </Border>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Распределение KNN (top score)" Grid.Row="1">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6" Foreground="Gray" Text="{Binding KnnDistributionStatus}" />
                                                <Border BorderBrush="#D5DEEA" BorderThickness="1" CornerRadius="6" Background="#FBFCFF" Padding="8">
                                                    <Canvas Height="180">
                                                        <Line X1="40" Y1="16" X2="40" Y2="156" Stroke="#7A8798" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="156" X2="560" Y2="156" Stroke="#7A8798" StrokeThickness="1.2" />
                                                        <TextBlock Canvas.Left="8" Canvas.Top="8" FontSize="11" Foreground="#5f6b7a" Text="Y: score" />
                                                        <TextBlock Canvas.Left="520" Canvas.Top="160" FontSize="11" Foreground="#5f6b7a" Text="X: rank" />
                                                        <Polyline Points="{Binding KnnDistributionPoints}" Stroke="#7C4DFF" StrokeThickness="2.6" />
                                                    </Canvas>
                                                </Border>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Админ: Пользователи" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel Margin="8">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button Content="Обновить" Command="{Binding LoadAdminUsersCommand}" />
                                        <Button Content="Сделать Admin" Command="{Binding MakeAdminCommand}" />
                                        <Button Content="Сделать User" Command="{Binding MakeUserCommand}" />
                                        <Button Content="Блок" Command="{Binding BlockUserCommand}" />
                                        <Button Content="Разблок" Command="{Binding UnblockUserCommand}" />
                                        <Button Content="Удалить" Command="{Binding DeleteUserCommand}" />
                                        <Button Content="Метрики KNN" Command="{Binding LoadMetricsCommand}" />
                                        <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" />
                                        <Button Content="Экспорт PDF" Command="{Binding ExportPdfCommand}" />
                                    </WrapPanel>

                                    <DataGrid ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding SelectedAdminUser}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Блок" Binding="{Binding IsBlocked}" Width="*" />
                                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAtUtc}" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Админ: Контент (CRUD)" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="Справочники" Command="{Binding LoadAdminDictionariesCommand}" />
                                        <Button Content="Создать" Command="{Binding CreateContentCommand}" />
                                        <Button Content="Обновить" Command="{Binding UpdateContentCommand}" />
                                        <Button Content="Удалить" Command="{Binding DeleteContentCommand}" />
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,8" Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Название" />
                                            <TextBox Height="30" Text="{Binding ContentTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0" Text="Ссылка (URL)" />
                                            <TextBox Height="30" Text="{Binding ContentUrl, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0" Text="Описание" />
                                            <TextBox Height="60" TextWrapping="Wrap" Text="{Binding ContentDescription, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Категория" />
                                            <ComboBox Height="30"
                                                      ItemsSource="{Binding Categories}"
                                                      SelectedItem="{Binding SelectedCategory}"
                                                      DisplayMemberPath="Name" />
                                            <TextBlock Margin="0,8,0,0" Text="TagIds CSV (guid,guid,...)" />
                                            <TextBox Height="30" Text="{Binding ContentTagIdsCsv, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="Gray"
                                                       Text="GUID тегов можно посмотреть во вкладке DB Viewer." />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="Текущий контент (выбери строку для Update/Delete)" />
                                    <DataGrid Grid.Row="3" ItemsSource="{Binding ContentItems}" SelectedItem="{Binding SelectedContent}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Админ: DB Viewer" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel Margin="8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button Content="Обновить" Command="{Binding LoadDbViewerCommand}" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Users={0} | Categories={1} | Tags={2} | Contents={3} | Actions={4}">
                                                    <Binding Path="DbOverview.Users" />
                                                    <Binding Path="DbOverview.Categories" />
                                                    <Binding Path="DbOverview.Tags" />
                                                    <Binding Path="DbOverview.Contents" />
                                                    <Binding Path="DbOverview.Actions" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <TabControl>
                                        <TabItem Header="Users">
                                            <DataGrid ItemsSource="{Binding DbUsers}" AutoGenerateColumns="True" IsReadOnly="True" />
                                        </TabItem>
                                        <TabItem Header="Categories">
                                            <DataGrid ItemsSource="{Binding DbCategories}" AutoGenerateColumns="True" IsReadOnly="True" />
                                        </TabItem>
                                        <TabItem Header="Tags">
                                            <DataGrid ItemsSource="{Binding DbTags}" AutoGenerateColumns="True" IsReadOnly="True" />
                                        </TabItem>
                                        <TabItem Header="Contents">
                                            <DataGrid ItemsSource="{Binding DbContents}" AutoGenerateColumns="True" IsReadOnly="True" />
                                        </TabItem>
                                        <TabItem Header="Actions">
                                            <DataGrid ItemsSource="{Binding DbActions}" AutoGenerateColumns="True" IsReadOnly="True" />
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Справка">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <Border Background="#F8FAFD" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Как пользоваться desktop-клиентом" />
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Text="1) Войдите в систему. 2) Вкладка 'Контент' — выполните действия Просмотр/Лайк/Клик. 3) Вкладка 'Рекомендации' — сравните Popular / By Categories / KNN. 4) Вкладка 'Графики и аналитика' — посмотрите профиль интересов и график распределения KNN." />
                                            </StackPanel>
                                        </Border>
                                        <Expander Header="Что означают результаты алгоритмов" IsExpanded="True" Margin="0,0,0,8">
                                            <TextBlock Margin="8" TextWrapping="Wrap"
                                                       Text="Popular — общий тренд. By Categories — предпочтения пользователя по категориям. KNN — персональная выдача по похожим пользователям. Explainability показывает вклад факторов в финальный score." />
                                        </Expander>
                                        <Expander Header="Почему график KNN может быть пустым" Margin="0,0,0,8">
                                            <TextBlock Margin="8" TextWrapping="Wrap"
                                                       Text="Если у пользователя нет действий, KNN не может построить устойчивую персонализацию. Добавьте 5-10 действий в разных категориях и обновите графики." />
                                        </Expander>
                                        <Expander Header="Что показывать аудитории (быстрый сценарий)">
                                            <TextBlock Margin="8" TextWrapping="Wrap"
                                                       Text="Сначала покажите контент и действия, затем разные рекомендации, потом Explainability и профиль интересов, и завершите вкладкой 'Графики и аналитика' с распределением KNN." />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="8" BorderBrush="#DDE3EA" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Status}"
                       FontWeight="SemiBold"
                       Margin="2,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding IsBusy, StringFormat=Загрузка: {0}}" />
                <ProgressBar Width="120" Height="12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
